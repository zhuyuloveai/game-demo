; My Universe — standalone sailing and trading experiment.
config_version=5

[application]
config/name="我的宇宙 · 青屿航记"
run/main_scene="res://scenes/voyage.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/description="亲自驾驶帆船往来三座港口，买卖货物、整备与更换船只，经营自己的航程。"

[display]
window/size/viewport_width=1280
window/size/viewport_height=880
window/size/window_width_override=1140
window/size/window_height_override=784
window/size/min_width=1100
window/size/min_height=760
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.025, 0.069, 0.09, 1)
