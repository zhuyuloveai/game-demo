{
  "schemaVersion": "1.0",
  "kind": "responsive-presentation-contract",
  "implementationStatus": "skin-and-field-mapping-only; no gameplay implementation",
  "configSource": "common/project-parameters-v04.json",
  "runtimeBindingNotice": "runtime paths are proposed view-model interface names, not assertions that these fields already exist. Integrator must adapt validated game state. Never derive economy from SVG/CSS.",
  "css": "ui/panel-skins.css",
  "sharedSkin": "ui/panel-skin.svg",
  "nineSlice": {
    "inset": 18,
    "sourceSize": [
      64,
      64
    ],
    "center": "stretch",
    "edges": "stretch"
  },
  "accessibility": {
    "minimumTargetCssPx": 44,
    "minimumViewportCssPx": 360,
    "textZoom": 1.5,
    "focusReturn": "restore triggering control on close",
    "modal": "use dialog semantics, focus trap and Escape close except in atomic settlement",
    "announcements": "aria-live polite for outcomes; assertive for actionable errors; no per-item spam",
    "numbers": "DOM text, tabular numerals, no text in SVG",
    "mapIsolation": "overscroll-behavior contain; do not hijack keyboard arrows inside inputs"
  },
  "panels": [
    {
