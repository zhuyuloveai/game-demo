  "rewards": [
    {
      "name": "雪夜里的第一盏灯",
      "short": "雪人与灯篱",
      "heading": "小小的灯，把雪照暖了。",
      "description": "暖灯亮在矮篱笆上，戴围巾的雪人也来守着这片小雪坡。",
      "claim": "把暖灯点起来",
      "icon": "flowers",
      "toast": "雪人和灯篱到家啦，雪夜开始有了温度。"
    },
    {
      "name": "围巾企鹅来做客",
      "short": "围巾企鹅",
      "heading": "雪上，多了一串小脚印。",
      "description": "一只系着珊瑚色围巾的小企鹅，沿着弯弯的脚印走来了。",
      "claim": "欢迎企鹅搬进来",
      "icon": "sheep",
      "toast": "小企鹅来啦，它正沿着脚印找你。"
    },
    {
      "name": "雪坡上的暖灯木屋",
      "short": "暖灯木屋",
      "heading": "从今以后，这里有一扇等你的窗。",
      "description": "右边的雪坡上有了小木屋。推开圆圆的门，冬天也可以很暖。",
      "claim": "把小木屋安在雪坡上",
      "icon": "house",
      "toast": "小木屋亮灯啦，沿着脚印就能回家。"
    },
    {
      "name": "守着小村的雪松",
      "short": "覆雪松树",
      "heading": "松树披着雪，轻轻站好了。",
      "description": "两棵覆雪的松树站在坡边，为木屋和冰湖添了一点安静的陪伴。",
      "claim": "请雪松在这里扎根",
      "icon": "tree",
      "toast": "雪松来啦，小村有了轻轻摇晃的守护者。"
    },
    {
      "name": "冰湖边的快乐午后",
      "short": "冰场与海豹",
      "heading": "冰湖边，传来了软软的笑声。",
      "description": "冰鞋与小扶栏摆到了原有冰湖的岸边，两只小海豹也来凑热闹。",
      "claim": "一起到冰湖边玩",
      "icon": "duck",
      "toast": "冰岸准备好啦，小海豹已经等不及了。"
    },
    {
      "name": "白狐和新朋友",
      "short": "白狐伙伴",
      "heading": "星光很轻，陪伴很暖。",
      "description": "小白狐坐在暖灯旁，又一只小企鹅加入了散步的队伍。星雪小村热闹起来了。",
      "claim": "让朋友们都住下来",
      "icon": "chick",
      "toast": "白狐来做邻居啦，这个冬天不再孤单。"
    }
  ]
